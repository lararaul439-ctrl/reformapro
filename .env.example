# --- Database -------------------------------------------------------------
# Default: a local SQLite file, created automatically on first start.
DATABASE_URL=file:./data/reformapro.db

# Online database (e.g. Turso). Use a libsql:// URL and its token:
# DATABASE_URL=libsql://your-database-your-org.turso.io
# DATABASE_AUTH_TOKEN=

# --- Access ----------------------------------------------------------------
# Optional single password. If set, every page asks for it at /acceso.
# Leave it empty for local use. Set it whenever the app is reachable from the internet.
# ACCESS_PASSWORD=

# Only if you serve the app over plain HTTP outside localhost (not recommended):
# the session cookie is "Secure" in production by default and browsers drop it on HTTP.
# INSECURE_COOKIES=1
